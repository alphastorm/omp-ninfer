[0.000, "o", "                                                                                          \u001b[0m\r\r\n \u001b[38;2;90;128;128mpop_oldest\u001b[39;3;38;2;108;108;108;3;38;2;108;108;108m:\u001b[39;23m                                                                                        \u001b[0m\r\r\n \u001b[38;2;88;132;88m- \u001b[39;38;2;90;128;128mitem = self._slots[self._head]\u001b[39m                                                                   \u001b[0m\r\r\n \u001b[38;2;88;132;88m- \u001b[39;38;2;90;128;128mself._slots[self._head] = None\u001b[39m                                                                   \u001b[0m\r\r\n\u001b[0m\u001b[K \u001b[38;2;88;132;88m- \u001b[39;38;2;90;128;128mself._head = self._head + 1\u001b[39;3;38;2;108;108;108;3;38;2;108;108;108m  ← bug: no modulo operation! head is not being wrapped around by     \u001b[0m\r\r\n   \u001b[3;38;2;108;108;108mcapacity.\u001b[39;23m                                                                                        \u001b[0m\r\r\n \u001b[38;2;88;132;88m- \u001b[39;38;2;90;128;128mself._count -= 1\u001b[39m                                                        "]
[0.000, "o", "                         \u001b[0m\r\r\n                                                                                                    \u001b[0m\r\r\n \u001b[3;38;2;108;108;108mThat is, when head reaches capacity, \u001b[39;23;38;2;90;128;128mself._slots[self._head]\u001b[39;3;38;2;108;108;108;3;38;2;108;108;108m becomes an IndexError. Example:       \u001b[0m\r\r\n \u001b[3;38;2;108;108;108;39;23;38;2;90;128;128mtest_reuse_after_drain\u001b[39;3;38;2;108;108;108;3;38;2;108;108;108m with capacity 2: push 1, 2 (head=0, count=2), pop (head=1, count=1), pop    \u001b[0m\r\r\n\u001b[0m\u001b[K \u001b[3;38;2;108;108;108m(head=2, count=0), push 3: tail = (2+0)%2 = 0, slots[0]=3, count=1. pop_oldest: slots[2] →         \u001b[0m\r\r\n \u001b[3;38;2;108;108;108mIndexError: list index out of range.\u001b[39;23m                                                               \u001b[0m\r\r\n                                                                                                    \u001b[0m\r\r\n \u001b[3;38;2;108;108;108mFix: \u001b[39;23;38;2;90;128;128mself._head = (self._head + 1) % self.capacity\u001b[39;3;38;2;108;108;1"]
