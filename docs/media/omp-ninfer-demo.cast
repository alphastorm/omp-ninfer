[0.002, "o", "\u001b[?25l\u001b[?2026h\u001b[?7l\u001b[26;1H\u001b[0m\u001b[K starts cycling — once it wraps, \u001b[38;2;90;128;128mpush\u001b[39m correctly modulo-wraps \u001b[38;2;90;128;128m_head\u001b[39m but \u001b[38;2;90;128;128mpop_oldest\u001b[39m doesn't, and that \u001b[0m\u001b[27;1H skew lets \u001b[38;2;90;128;128m_head\u001b[39m drift past the last slot on subsequent cycles.                                     \u001b[0m\u001b[30;4H\u001b[?25h\u001b[?7h\u001b[?2026l"]
